<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.modula.systemcontentstudio"
  ExtensionBundleVersion="1.0.0" ExtensionBundleName="System Content Studio">
  <ExtensionList>
    <Extension Id="com.modula.systemcontentstudio.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO = Premiere Pro. El rango va abierto por arriba a propósito:
           Adobe sube el número de versión del host cada año y un techo fijo
           haría que el panel dejara de aparecer tras una actualización. -->
      <Host Name="PPRO" Version="[15.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.modula.systemcontentstudio.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- El panel pide a http://localhost:3000 (la app Next). Sin esto,
                 Chromium bloquea la petición por mixed-content/CORS incluso
                 con las cabeceras del servidor puestas. -->
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>System Content Studio</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
