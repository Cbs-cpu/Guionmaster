# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local (contenido personal, no se versiona)
/data/studio.db
/data/studio.db-shm
/data/studio.db-wal

# data/media SÍ se versiona (vía Git LFS, ver .gitattributes) salvo lo de
# abajo — archivos sueltos demasiado grandes para el límite de GitHub LFS
# (2 GB por archivo). Si generas otro así, añádelo aquí a mano.
/data/media/generated/subtitulos-render-subs_m6kmpgz8xt-overlay.mov

# Cerrojo del generador de imágenes (scripts/gen-capas-contexto.mjs)
.gen.lock
